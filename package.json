{
  "name": "colors-lab",
  "version": "1.0.0",
  "description": "COP 4331 Colors Lab (LAMP). Node.js is used only for linting tools in CI.",
  "private": true,
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint public/js",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:html": "htmlhint \"public/**/*.html\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
